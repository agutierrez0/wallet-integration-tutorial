# Xaman developer console: https://apps.xumm.dev
XAMAN_API_KEY=
XAMAN_API_SECRET=

PORT=3001
# Comma-separated list of browser origins allowed to call this API
ALLOWED_ORIGIN=http://localhost:3000
# Set to true only when running behind a reverse proxy (nginx) so the rate limiter reads X-Forwarded-For
TRUST_PROXY=false
