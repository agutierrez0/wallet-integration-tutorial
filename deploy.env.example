# Runtime variables for the signing server (Coolify "Environment Variables" for the `server`
# service). NAMES with fake placeholders only: never commit real values, never use build args.
# For local dev put these in server/.env instead (see server/.env.example).
XAMAN_API_KEY=00000000-0000-0000-0000-000000000000
XAMAN_API_SECRET=00000000-0000-0000-0000-000000000000
# Exact browser origin(s) of the deployed web app, comma-separated, e.g. https://sandbox.example.com
ALLOWED_ORIGIN=https://sandbox.example.com
# true behind nginx/Coolify so the rate limiter reads the real client IP (compose sets this already)
TRUST_PROXY=true
# Mainnet payloads are refused unless this is true. Leave unset/false for a testnet sandbox.
ALLOW_MAINNET=false
